{
  "name": "paprika-mcp-server",
  "version": "2.1.2",
  "description": "MCP server that provides AI assistants access to Paprika Recipe Manager data",
  "bin": {
    "paprika-mcp-server": "./dist/index.cjs"
  },
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint",
    "fix": "eslint --fix",
    "build": "node esbuild.config.js && chmod +x dist/index.cjs",
    "package": "mcpb pack . paprika-mcp-server.mcpb",
    "version": "changeset version && node scripts/sync-manifest-version.js",
    "start": "tsx src/index.ts"
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.12.4",
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/unzipper": "^0.10.11",
    "esbuild": "^0.28.1",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.31.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@rushstack/ts-command-line": "^5.3.12",
    "jiti": "^2.7.0",
    "unzipper": "^0.12.5",
    "zod-to-json-schema": "^3.25.2"
  }
}